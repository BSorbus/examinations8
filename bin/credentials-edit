#!/usr/bin/env ruby
# Edycja credentials, także na serwerze wdrożonym przez mina.
#
# Na serwerze config/credentials/<środowisko>.yml.enc w wydaniu to dowiązanie do shared/. Standardowe
# `bin/rails credentials:edit` zapisuje przez `mv` i zastąpiłoby dowiązanie zwykłym plikiem w wydaniu –
# zmiana zniknęłaby przy następnym wdrożeniu. Ten skrypt zapisuje do pliku, na który wskazuje dowiązanie.
#
# Użycie:  EDITOR=nano bin/credentials-edit [środowisko]     (domyślnie production)
# Po zmianie na serwerze: touch tmp/restart.txt (albo lokalnie `bundle exec mina test2 restart`).
require "bundler/setup"
require "active_support"
require "active_support/encrypted_configuration"
require "shellwords"

env = ARGV.first || "production"
root = File.expand_path("..", __dir__)
content_path = File.realpath(File.join(root, "config/credentials/#{env}.yml.enc"))
key_path = File.realpath(File.join(root, "config/credentials/#{env}.key"))
editor = ENV["EDITOR"].to_s.empty? ? "nano" : ENV["EDITOR"]

credentials = ActiveSupport::EncryptedConfiguration.new(
  config_path: content_path, key_path: key_path, env_key: "RAILS_MASTER_KEY", raise_if_missing_key: true
)
before = File.binread(content_path)
credentials.change { |tmp_path| system(*Shellwords.split(editor), tmp_path.to_s) || abort("Edytor zakończył się błędem – bez zmian.") }

if File.binread(content_path) == before
  puts "Credentials (#{env}) bez zmian: #{content_path}"
else
  puts "Credentials (#{env}) zapisane w: #{content_path} – zrestartuj aplikację (touch tmp/restart.txt)."
end
